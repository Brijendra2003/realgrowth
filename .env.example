# Copy to .env.local and fill in. Set the same values in your hosting dashboard.
# Never commit .env.local.

# Signs the session cookie. Required, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out.
SESSION_SECRET=

# Public address of the site, no trailing slash (used in the sitemap and robots.txt).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Supabase → Project Settings → API. The service role key is server only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary → Settings → API Keys. Either these three…
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# …or the single URL form: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Cloudflare Turnstile (bot check on sign-in, sign-up and enquiries).
# Cloudflare dashboard → Turnstile → Add widget → add your domain (and localhost for testing).
# Until both are set, the forms are NOT protected against bots.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
