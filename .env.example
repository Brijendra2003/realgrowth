# Copy to .env.local and fill in.

# Signs the session cookie. Use a long random string in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to 1 to show the demo-account helper on sign-in pages in production builds.
SHOW_DEMO_ACCOUNTS=

# ── Production backends (Architecture §13) — not needed for local development ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=              # server only
